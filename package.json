{
  "name": "lyrics-overlay",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Timed one-line lyrics over the desktop for YouTube playback, with an optional sung-pitch trace.",
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "test:service": "node --test tests/service-gjs.test.mjs",
    "test:shell": "node --test tests/e2e/overlay.e2e.mjs",
    "lint": "web-ext lint --source-dir firefox --self-hosted",
    "release:firefox": "bash scripts/release-firefox.sh"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
