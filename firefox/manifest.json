{
  "manifest_version": 3,
  "name": "Lyrics Overlay",
  "version": "1.2.0",
  "description": "Tells the local lyrics overlay service what YouTube is playing. Sends nothing off this computer.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://music.youtube.com/*",
    "http://lyrics.localhost/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "settings-access.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "youtube-page.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lyrics-overlay@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
